# Required only for `meta experiment run`; keep the real value in ignored `.env`.
META_OPENROUTER_API_KEY=

# Five comma-separated OpenRouter candidate model identifiers, in review order.
META_EXPERIMENT_MODELS=model-one,model-two,model-three,model-four,model-five

# Set only after the Phase 0 human qualification gate selects a model.
META_LORE_MODEL=
